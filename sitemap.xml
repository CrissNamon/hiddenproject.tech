---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod>
  </url>
  {%- for game in site.data.games %}
  <url>
    <loc>{{ game.slug | prepend: '/' | append: '/' | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ game.privacy | absolute_url }}</loc>
  </url>
  {%- endfor %}
  <url>
    <loc>{{ '/blog/' | absolute_url }}</loc>
    {%- if site.posts.size > 0 %}
    <lastmod>{{ site.posts.first.date | date: '%Y-%m-%d' }}</lastmod>
    {%- endif %}
  </url>
  {%- for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date: '%Y-%m-%d' }}</lastmod>
  </url>
  {%- endfor %}
  <url>
    <loc>{{ '/privacy.html' | absolute_url }}</loc>
  </url>
</urlset>
